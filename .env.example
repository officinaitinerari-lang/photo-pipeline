# =====================================================================================
#  photo-pipeline — configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# =====================================================================================

# ---------- Container user (docker-compose) -----------------------------------------
# UID/GID owning the shared folder on the NAS (run `id` via SSH on UGOS to find them).
PUID=1000
PGID=1000
# GitHub user/org that publishes the image on ghcr.io (used by docker-compose.yml)
GHCR_OWNER=your-github-user

# ---------- Google Gemini (FREE tier) -------------------------------------------------
# Free key: https://aistudio.google.com/apikey  (no credit card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Minimum pause between two requests (seconds). Free-tier RPM limits are low: keep >= 6.
GEMINI_MIN_INTERVAL_SECONDS=6
# Retries with exponential backoff on HTTP 429/5xx
GEMINI_MAX_RETRIES=6
GEMINI_BACKOFF_BASE_SECONDS=4
GEMINI_BACKOFF_MAX_SECONDS=120
# When the daily quota is exhausted the photo is NOT failed: it is retried after this cooldown
GEMINI_QUOTA_COOLDOWN_MINUTES=60
# -1 = model default (dynamic thinking); 0 = disable thinking (faster, fewer tokens)
GEMINI_THINKING_BUDGET=-1

# ---------- Watcher --------------------------------------------------------------------
# Seconds a file size must stay unchanged before it is processed (SMB/NFS copy safety)
STABLE_SECONDS=5
# true = polling observer (use if files arrive through a mount that does not emit inotify events)
WATCH_USE_POLLING=false
# Words in file or folder names that mark an analog film scan (grain-safe processing)
ANALOG_KEYWORDS=analog,analogico,film,35mm,120mm,pellicola,kodak,ilford,fuji,portra,ektar,hp5,tri-x

# ---------- Upscaling / prints ------------------------------------------------------------
# Upscale only if the long side is below this (6000 px = 50x70 cm @ 300 DPI)
UPSCALE_THRESHOLD_PX=6000
UPSCALE_TARGET_LONG_SIDE=7200
# onnx = Real-ESRGAN compact on CPU (falls back to lanczos automatically), lanczos = never use AI
UPSCALE_ENGINE=onnx
UPSCALE_TILE_SIZE=512
UPSCALE_TILE_OVERLAP=24
ONNX_THREADS=2
PRINT_DPI=300
# Max size of a single print JPEG (quality is reduced only if needed, never below JPEG_QUALITY_MIN)
MAX_PRINT_FILE_MB=19
JPEG_QUALITY_PRINTS=95
JPEG_QUALITY_MIN=82
# Etsy limit is 20 MB per file: zips above this are split into _part1, _part2, ...
ETSY_ZIP_MAX_MB=19.5

# ---------- Microstock metadata ------------------------------------------------------------
MICROSTOCK_JPEG_QUALITY=95
MICROSTOCK_MIN_MEGAPIXELS=4
# Copy GPS coordinates into the microstock JPEG (privacy: default false)
MICROSTOCK_KEEP_GPS=false
AUTHOR_NAME=
COPYRIGHT_NOTICE=

# ---------- Upload safety --------------------------------------------------------------------
# true = uploads are only SIMULATED in the logs. Switch to false after checking the first outputs,
# then run `docker exec photo-pipeline python -m src.main upload-pending` to send those files.
DRY_RUN=true
UPLOAD_MAX_RETRIES=3
UPLOAD_TIMEOUT_SECONDS=120

# ---------- Adobe Stock (SFTP) -------------------------------------------------------------------
# Contributor portal -> Upload -> "Upload with SFTP" -> Generate password
ADOBE_ENABLED=false
ADOBE_PROTOCOL=sftp
ADOBE_HOST=sftp.contributor.adobestock.com
ADOBE_PORT=22
ADOBE_USERNAME=
ADOBE_PASSWORD=
ADOBE_REMOTE_DIR=/

# ---------- Shutterstock (FTPS) -------------------------------------------------------------------
# Contributor account -> Upload -> FTPS credentials (username = account email)
SHUTTERSTOCK_ENABLED=false
SHUTTERSTOCK_PROTOCOL=ftps
SHUTTERSTOCK_HOST=ftps.shutterstock.com
SHUTTERSTOCK_PORT=21
SHUTTERSTOCK_USERNAME=
SHUTTERSTOCK_PASSWORD=
SHUTTERSTOCK_REMOTE_DIR=/

# ---------- Telegram notifications (optional) --------------------------------------------------------
# Create a bot with @BotFather, then get the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Worker / logging ----------------------------------------------------------------------------
MAX_JOB_ATTEMPTS=3
RETRY_DELAY_MINUTES=10
LOG_LEVEL=INFO
# json (structured, for log collectors) or text (human readable)
LOG_FORMAT=json

# --- Etsy drafts (optional) -----------------------------------------------------------
# Creates DRAFT listings only: you review and publish them on Etsy (the listing fee is charged then).
# Register a personal app on https://www.etsy.com/developers and copy keystring + shared secret.
ETSY_ENABLED=false
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=https://localhost/etsy-callback
ETSY_LANGUAGE=it
# Also fill the other language (it <-> en) as an Etsy translation; the shop must have that language enabled
ETSY_TRANSLATE=true
ETSY_PRICE=4.90
